# Нормализация переносов строк. Текстовые файлы Godot держим в LF,
# чтобы git не помечал сцены изменёнными на разных машинах (Windows CRLF).
* text=auto eol=lf

*.gd    text eol=lf
*.tscn  text eol=lf
*.tres  text eol=lf
*.godot text eol=lf
*.cfg   text eol=lf
*.import text eol=lf
*.svg   text eol=lf

# Бинарные ассеты
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.ogg  binary
*.wav  binary
*.mp3  binary
*.ttf  binary
*.otf  binary
